# Public workspace identity configuration
CLERK_PUBLISHABLE_KEY=

# Server-only identity verification
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:8888,https://sengeradvisory.com

# Server-only runtime role. Must be a non-owner without BYPASSRLS.
NEON_DATABASE_URL=

# Local/CI migration role only. Never configure this in the browser or runtime function.
NEON_MIGRATION_DATABASE_URL=

# Deployment mode: development, preview, or production
WORKSPACE_ENVIRONMENT=development

# Server-only Senger Advisory Platform Operations authority.
# Use explicit Clerk user IDs; never expose this value to browser configuration.
PLATFORM_OPERATOR_USER_IDS=

# Public OneCal booking pages. A shared link may be used for all three during POC validation.
ONECAL_BOOKING_URL=
ONECAL_GUIDANCE_BOOKING_URL=
ONECAL_DESIGN_BOOKING_URL=
ONECAL_REVELATION_BOOKING_URL=
